        "'''next dataset'''\n",
        "\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Load your stops file (CSV or Excel)\n",
        "df = pd.read_excel('/content/stop.xlsx')  # Or pd.read_csv('stops.txt')\n",
        "\n",
        "# Drop missing critical fields and exact duplicates\n",
        "df = df.dropna(subset=['stop_id', 'stop_name', 'stop_lat', 'stop_lon'])\n",
        "df = df.drop_duplicates(subset=['stop_id'])"
      ],
      "metadata": {
        "id": "-nNhSGxMsnz9"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Convert to float\n",
        "df['stop_lat'] = pd.to_numeric(df['stop_lat'], errors='coerce')\n",
        "df['stop_lon'] = pd.to_numeric(df['stop_lon'], errors='coerce')\n",
        "\n",
        "# Filter for valid latitude/longitude bounds in Telangana State\n",
        "df = df[(df['stop_lat'].between(15.0, 20.0)) & (df['stop_lon'].between(77.0, 81.0))]"
      ],
      "metadata": {
        "id": "PECNqlhasn2e"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Strip extra whitespace and standardize text columns\n",
        "text_cols = ['stop_id', 'stop_name', 'zone_id', 'stop_desc']\n",
        "for col in text_cols:\n",
        "    df[col] = df[col].astype(str).str.strip()\n",
        "\n",
        "# Clean stop_desc abbreviations (e.g., expand 'twd' to 'towards')\n",
        "df['stop_desc_clean'] = df['stop_desc'].str.replace(r'\\btwd\\b', 'towards', case=False, regex=True)\n",
        "df['stop_desc_clean'] = df['stop_desc_clean'].str.title()"
      ],
      "metadata": {
        "id": "U9C53K9Jsn5Q"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "abbreviations = {\n",
        "    r'\\bCBS\\b': 'Central Bus Station',\n",
        "    r'\\bMGBS\\b': 'Mahatma Gandhi Bus Station',\n",
        "    r'\\bJBS\\b': 'Jubilee Bus Station',\n",
        "    r'\\bHNK\\b': 'Hanamkonda',\n",
        "    r'\\bKZP\\b': 'Kazipet',\n",
        "    r'\\bWGL\\b': 'Warangal'\n",
        "}\n",
        "\n",
        "for abbr, full_text in abbreviations.items():\n",
        "    df['stop_name'] = df['stop_name'].str.replace(abbr, full_text, regex=True)\n",
        "    df['stop_desc_clean'] = df['stop_desc_clean'].str.replace(abbr, full_text, regex=True)"
      ],
      "metadata": {
        "id": "o-sS-9vksn8v"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df['nlp_stop_description'] = (\n",
        "    \"Bus stop \" + df['stop_name'] +\n",
        "    \" located at (\" + df['stop_lat'].astype(str) + \", \" + df['stop_lon'].astype(str) +\n",
        "    \"), description: \" + df['stop_desc_clean']\n",
        ")"
      ],
      "metadata": {
        "id": "HlpMSg4HuUL8"
      },
      "execution_count": null,
